# Copy to .env at the repository root for local development.
# The values below match docker-compose.yml. They are local placeholders, not production secrets.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://campaign:campaign@localhost:5432/campaign
REDIS_URL=redis://localhost:6379

# Override Docker Compose host ports if the defaults conflict with existing services
# POSTGRES_PORT=5432
# REDIS_PORT=6379

JWT_ACCESS_SECRET=dev_access_secret_replace_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_replace_in_production_min_32_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=campaign-api
JWT_AUDIENCE=campaign-clients

ACTIVATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
PASSWORD_MIN_LENGTH=8

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
