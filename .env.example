# Copy to .env at the repository root for local development.
# The values below match docker-compose.yml. They are local placeholders, not production secrets.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://campaign:campaign@localhost:5432/campaign
REDIS_URL=redis://localhost:6379

# Override Docker Compose host ports if the defaults conflict with existing services
# POSTGRES_PORT=5432
# REDIS_PORT=6379

JWT_ACCESS_SECRET=dev_access_secret_replace_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_replace_in_production_min_32_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=campaign-api
JWT_AUDIENCE=campaign-clients

ACTIVATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
PASSWORD_MIN_LENGTH=8
DEFAULT_PHONE_REGION=MY

# OIDC client IDs used as ID token audiences. Empty is allowed in development/test.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Public admin web origin used in activation and password-reset email links
# (`/activate?token=` and `/reset-password?token=`). Required in production.
PUBLIC_WEB_BASE_URL=http://localhost:8080

# Outbound notification providers. With SMTP_HOST unset in development/test,
# email stays log-only. Production requires SMTP_HOST and MAIL_FROM.
# Local catcher: docker compose --profile dev up -d  (MailHog UI http://localhost:8025)
NOTIFICATION_EMAIL_PROVIDER=dev
NOTIFICATION_SMS_PROVIDER=dev
NOTIFICATION_PUSH_PROVIDER=dev
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@localhost
# MAILHOG_SMTP_PORT=1025
# MAILHOG_UI_PORT=8025
SMS_FROM=
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_INTERVAL_MS=60000

# Comma-separated browser origins. Empty disables CORS (same-origin / non-browser clients).
# Local admin web: CORS_ORIGINS=http://localhost:8080 (must match PUBLIC_WEB_BASE_URL / --web-port).
CORS_ORIGINS=
HELMET_ENABLED=true
# Auth endpoint rate limit. Disabled in test unless AUTH_RATE_LIMIT_ENABLED=true.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=20

# First platform-admin setup. Empty disables GET/POST /setup/*.
# Generate with: openssl rand -hex 32 — then remove after the first admin is created.
SETUP_KEY=
